# Backend Environment Variables
DATABASE_URL=postgresql://banking_user:banking_password@postgres:5432/banking_db
REDIS_URL=redis://:redis_password@redis:6379
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Security
SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@banking.com

# Admin User
FIRST_SUPERUSER=admin@banking.com
FIRST_SUPERUSER_PASSWORD=admin123

# Transaction Limits
DAILY_TRANSFER_LIMIT=10000.0
SINGLE_TRANSFER_LIMIT=5000.0
LARGE_TRANSACTION_THRESHOLD=1000.0

# Security Settings
PASSWORD_MIN_LENGTH=8
FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=300

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# Frontend Environment Variables
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000/ws